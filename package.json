{
  "name": "prisma-commenter",
  "version": "0.1.1",
  "description": "Sync Prisma schema /// doc comments to database COMMENT ON statements",
  "type": "module",
  "bin": {
    "prisma-commenter": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bash integration/run.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "prisma",
    "comment",
    "database",
    "schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/takeshi-kishima/prisma-commenter.git"
  },
  "homepage": "https://github.com/takeshi-kishima/prisma-commenter#readme",
  "bugs": {
    "url": "https://github.com/takeshi-kishima/prisma-commenter/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "prisma": "^6.19.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@mrleebo/prisma-ast": "^0.15.0",
    "@prisma/client": "^6.19.3",
    "commander": "^14.0.3",
    "dotenv": "^17.4.1",
    "dotenv-expand": "^12.0.3",
    "mysql2": "^3.20.0",
    "pg": "^8.20.0"
  }
}
